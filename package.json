{
  "name": "diskscribe2026",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone desktop app for PC-98 disk images (.hdi, .nhd, .d88, .hdm, .hdd, .fdi, .fdd) with partition/FAT inspection and Shift-JIS tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atoadwhocodes/Diskscribe2026.git"
  },
  "bugs": {
    "url": "https://github.com/atoadwhocodes/Diskscribe2026/issues"
  },
  "homepage": "https://github.com/atoadwhocodes/Diskscribe2026#readme",
  "scripts": {
    "core:build": "tsc --project tsconfig.json",
    "core:dev": "tsc --project tsconfig.json --watch",
    "core:test": "jest --config jest.config.js",
    "core:typecheck": "tsc --project tsconfig.json --noEmit",
    "desktop:install": "npm --prefix apps/diskscribe-2026-desktop ci",
    "desktop:start": "npm --prefix apps/diskscribe-2026-desktop run start",
    "desktop:lint": "npm --prefix apps/diskscribe-2026-desktop run lint",
    "desktop:typecheck": "npm --prefix apps/diskscribe-2026-desktop run typecheck",
    "desktop:package": "npm --prefix apps/diskscribe-2026-desktop run package",
    "desktop:make": "npm --prefix apps/diskscribe-2026-desktop run make",
    "doctor": "node scripts/doctor.mjs",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "check:ui-wiring": "node scripts/check-ui-wiring.mjs",
    "start": "npm run desktop:start",
    "lint": "npm run desktop:lint",
    "typecheck": "npm run core:typecheck && npm run desktop:typecheck",
    "build": "npm run core:build && npm run desktop:make",
    "package": "npm run core:build && npm run desktop:make"
  }
}

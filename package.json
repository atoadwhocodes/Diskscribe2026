{
  "name": "diskscribe-2026",
  "displayName": "DiskScribe2026",
  "description": "Custom editor for PC-98 disk images (.hdi, .nhd, .d88, .hdm, .hdd, .fdi, .fdd) with partition/FAT inspector and Shift-JIS preview.",
  "version": "0.0.1",
  "publisher": "your-name-or-handle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atoadwhocodes/Diskscribe2026.git"
  },
  "bugs": {
    "url": "https://github.com/atoadwhocodes/Diskscribe2026/issues"
  },
  "homepage": "https://github.com/atoadwhocodes/Diskscribe2026#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onCustomEditor:pc98.dskedit",
    "onCommand:pc98.jumpToPartition",
    "onCommand:pc98.jumpToLba",
    "onCommand:pc98.jumpToOffset",
    "onCommand:pc98.copyOffset",
    "onCommand:pc98.copyLba",
    "onCommand:pc98.extractSelection",
    "onCommand:pc98.openVirtualDisk"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pc98.dskedit",
        "displayName": "DiskScribe2026",
        "selector": [
          {
            "filenamePattern": "*.hdi"
          },
          {
            "filenamePattern": "*.nhd"
          },
          {
            "filenamePattern": "*.d88"
          },
          {
            "filenamePattern": "*.hdm"
          },
          {
            "filenamePattern": "*.hdd"
          },
          {
            "filenamePattern": "*.fdi"
          },
          {
            "filenamePattern": "*.fdd"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pc98.jumpToPartition",
        "title": "PC-98: Jump to Partition"
      },
      {
        "command": "pc98.jumpToLba",
        "title": "PC-98: Jump to LBA"
      },
      {
        "command": "pc98.jumpToOffset",
        "title": "PC-98: Jump to Offset (Hex/Dec)"
      },
      {
        "command": "pc98.copyOffset",
        "title": "PC-98: Copy Offset"
      },
      {
        "command": "pc98.copyLba",
        "title": "PC-98: Copy LBA"
      },
      {
        "command": "pc98.extractSelection",
        "title": "PC-98: Extract Selected Bytes"
      },
      {
        "command": "pc98.openVirtualDisk",
        "title": "PC-98: Open Disk via Virtual Document"
      }
    ],
    "keybindings": [
      {
        "command": "pc98.jumpToPartition",
        "key": "ctrl+alt+p",
        "when": "editorFocus && resourceExtname =~ /\\.(hdi|nhd|d88|hdm|hdd|fdi|fdd)$/"
      }
    ],
    "configuration": {
      "title": "DiskScribe2026",
      "properties": {
        "diskscribe2026.hex.pageBytes": {
          "type": "integer",
          "default": 65536,
          "minimum": 4096,
          "maximum": 1048576,
          "description": "Byte page size used by the extension-host hex reader cache."
        },
        "diskscribe2026.hex.maxCachedPages": {
          "type": "integer",
          "default": 32,
          "minimum": 1,
          "maximum": 1024,
          "description": "Maximum number of cached pages per open disk editor session."
        },
        "diskscribe2026.hex.defaultMode": {
          "type": "string",
          "enum": [
            "disk",
            "raw"
          ],
          "default": "disk",
          "description": "Default hex view mode: disk (LBA0 base) or raw (file offset base)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile:ext": "tsc -p ./tsconfig.json",
    "compile:webview": "webpack --config webpack.webview.config.js",
    "compile": "npm run compile:ext && npm run compile:webview",
    "watch:ext": "tsc -watch -p ./tsconfig.json",
    "watch:webview": "webpack --config webpack.webview.config.js --watch",
    "watch": "npm-run-all --parallel watch:ext watch:webview",
    "test": "npm run compile && node ./dist/test/runTest.js",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository",
    "package": "npm run package:vsix",
    "publish": "vsce publish",
    "desktop:start": "npm --prefix apps/diskscribe-2026-desktop run start",
    "desktop:make": "npm --prefix apps/diskscribe-2026-desktop run make"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.90.0",
    "npm-run-all": "^4.1.5",
    "ts-loader": "^9.5.1",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.6.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  }
}
